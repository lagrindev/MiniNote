<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MiniNote" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Можно добавить цвета, но не обязательно -->
    </style>

    <style name="Theme.MiniNote.Splash" parent="Theme.SplashScreen">
        <!-- Фон -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>

        <!-- Иконка -->
        <item name="windowSplashScreenAnimatedIcon">
            @mipmap/ic_launcher_foreground
        </item>

        <!-- После splash -->
        <item name="postSplashScreenTheme">
            @style/Theme.MiniNote
        </item>
    </style>

</resources>